# ==============================================================================
# MUPEZENI RETAIL COMMERCE & AI WORKFORCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. RENDER BACKEND (FastAPI / Python Service with Custom LLM)
RENDER_BACKEND_URL="https://mupezeni-ai.onrender.com"
VITE_RENDER_BACKEND_URL="https://mupezeni-ai.onrender.com"

# 2. SUPABASE URL (From your Supabase Project Settings -> API)
# Used for PostgreSQL Database, Merchant Accounts & Native Mupezeni Catalog
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 3. SUPABASE ANON / PUBLIC KEY (From your Supabase Project Settings -> API)
# Safe for client-side authentication and public catalog reads
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. SUPABASE SERVICE ROLE KEY (From your Supabase Project Settings -> API)
# Used ONLY on the backend / Render backend for admin operations & bypassing RLS
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 5. APP DEPLOYMENT URL
APP_URL="MY_APP_URL"
